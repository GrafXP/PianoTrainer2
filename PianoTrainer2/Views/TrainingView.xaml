<UserControl x:Class="PianoTrainer2.Views.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:PianoTrainer2.Controls"
             xmlns:root="clr-namespace:PianoTrainer2"
             xmlns:vm="clr-namespace:PianoTrainer2.ViewModels"
             Background="#1e1e1e" Foreground="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,4">
            <!-- Built-in songs -->
            <TextBlock Text="Song:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="280" ItemsSource="{Binding BuiltInSongs}"
                      SelectedItem="{Binding SelectedBuiltIn, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            <TextBlock Text="or" VerticalAlignment="Center" Margin="8,0"/>
            <Button Content="Browse .mid…" Command="{Binding BrowseCommand}"
                    Padding="6,2" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CustomMidiPath}" VerticalAlignment="Center"
                       Foreground="#aaa" Margin="6,0" MaxWidth="200"
                       TextTrimming="CharacterEllipsis"/>

            <Separator Width="1" Background="#555" Margin="10,0"/>

            <!-- Mode -->
            <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="130" ItemsSource="{Binding ModeValues}"
                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                      VerticalAlignment="Center"/>

            <Separator Width="1" Background="#555" Margin="10,0"/>

            <!-- Play/Stop -->
            <Button Content="▶ Start" Command="{Binding StartCommand}"
                    Padding="10,2" VerticalAlignment="Center" Foreground="LimeGreen"/>
            <Button Content="■ Stop"  Command="{Binding StopCommand}"
                    Padding="10,2" VerticalAlignment="Center" Foreground="OrangeRed" Margin="6,0,0,0"/>

            <Separator Width="1" Background="#555" Margin="10,0"/>

            <!-- Score -->
            <TextBlock Text="Score:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Text="{Binding Score}" VerticalAlignment="Center" FontWeight="Bold"
                       Foreground="DeepSkyBlue" MinWidth="40"/>
            <TextBlock Text="Combo:" VerticalAlignment="Center" Margin="6,0,4,0"/>
            <TextBlock Text="{Binding Combo}" VerticalAlignment="Center" FontWeight="Bold"
                       Foreground="Gold" MinWidth="30"/>
        </StackPanel>

        <!-- Download progress -->
        <ProgressBar DockPanel.Dock="Top" Height="4" Minimum="0" Maximum="100"
                     Value="{Binding DownloadProgress}"
                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Status bar -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}"
                   Foreground="#aaa" Margin="8,2,8,4" FontSize="11"/>

        <!-- Piano keyboard (bottom) -->
        <ScrollViewer DockPanel.Dock="Bottom" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Height="130">
            <root:PianoKeyboard x:Name="TrainingKeyboard"
                                ActiveKeys="{Binding DataContext.ActiveKeys, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                PendingKeys="{Binding PendingKeys}"/>
        </ScrollViewer>

        <!-- Highway (fills remaining space) -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ctrl:NoteHighwayControl x:Name="Highway"
                                     Width="{x:Static ctrl:PianoKeyboardLayout.TotalWidth}"
                                     MinHeight="400"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
